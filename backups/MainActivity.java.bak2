        void setEan(String s){ean=s;invalidate();}
        String checksum(String s){int sum=0;for(int i=0;i<12;i++)sum+=(s.charAt(i)-48)*((i%2==0)?1:3);return Integer.toString((10-sum%10)%10);}
        String normalize(){
            String s=ean.replaceAll("[^0-9]","");
            if(s.length()==12)return s+checksum(s);
            if(s.length()==13)return s.substring(0,12)+checksum(s.substring(0,12));
            while(s.length()<12)s+="0";
            return s.substring(0,12)+checksum(s.substring(0,12));
        }
        String modules(String c){
            String[] L={"0001101","0011001","0010011","0111101","0100011","0110001","0101111","0111011","0110111","0001011"};
            String[] G={"0100111","0110011","0011011","0100001","0011101","0111001","0000101","0010001","0001001","0010111"};
            String[] R={"1110010","1100110","1101100","1000010","1011100","1001110","1010000","1000100","1001000","1110100"};
            String[] P={"LLLLLL","LLGLGG","LLGGLG","LLGGGL","LGLLGG","LGGLLG","LGGGLL","LGLGLG","LGLGGL","LGGLGL"};
            StringBuilder b=new StringBuilder("101"); String p=P[c.charAt(0)-48];
            for(int i=0;i<6;i++){int d=c.charAt(i+1)-48;b.append(p.charAt(i)=='L'?L[d]:G[d]);}
            b.append("01010"); for(int i=7;i<13;i++)b.append(R[c.charAt(i)-48]); b.append("101"); return b.toString();
        }
        float bboxWidth(String d){Path p=PathParser.createPathFromPathData(d);RectF b=new RectF();p.computeBounds(b,true);return b.width();}

        void drawBarcode(Canvas canvas,int w,int h){
            canvas.drawColor(Color.WHITE);
            String code=normalize();

            // The printer bitmap has one fixed width. Preview is only a scaled view
            // of the same logical geometry.
            float logicalW=PRINT_W;
            float availableW=logicalW-LEFT_MARGIN_PX-RIGHT_MARGIN_PX;

            float sy=Math.max(0.15f,(h*0.58f)/(464.5f-8f));
            float digitScale=sy*digitWidth;

            String firstGlyph=glyphs.get(code.charAt(0));
            float leadW=bboxWidth(firstGlyph)*digitScale;
            float left=LEFT_MARGIN_PX;
            float gap=leadW*.5f;
            float right=RIGHT_MARGIN_PX;

            float barLeft=left+leadW+gap;
            float barW=Math.max(1f,logicalW-barLeft-right);

            float top=TOP_MARGIN_PX;
            float dataH=(REF_DATA_Y1-REF_Y_TOP)*sy*barHeight;
            float guardH=Math.max(dataH,(REF_GUARD_Y1-REF_Y_TOP)*sy*barHeight);

            // X/Y resizing may change the barcode rectangle, but glyphs themselves
            // always use one uniform scale, so digits never become stretched.
            float contentScale=(w/logicalW)*zoom;
            float ox=(w-logicalW*contentScale)/2f+moveX*w*.35f;
            float oy=moveY*h*.35f;

            canvas.save();
            canvas.translate(ox,oy);
            canvas.scale(contentScale*scaleX,contentScale*scaleY);

            // Clip to the mandatory global margins. Anything crossing them is
            // intentionally truncated rather than moving the margins.
            canvas.clipRect(LEFT_MARGIN_PX,TOP_MARGIN_PX,logicalW-RIGHT_MARGIN_PX,h);

            paint.setStyle(Paint.Style.FILL);
            paint.setColor(Color.BLACK);

            String m=modules(code);
            float mw=barW/95f;
            for(int i=0;i<95;){
                if(m.charAt(i)=='1'){
                    int j=i+1;
                    while(j<95&&m.charAt(j)=='1')j++;
                    boolean guard=i<3||i>=92||(i>=45&&i<50);
                    float bh=guard?guardH:dataH;
                    canvas.drawRect(barLeft+i*mw,top,barLeft+j*mw,top+bh,paint);
                    i=j;
                }else i++;
            }

            float scaledBarW=barW;
            for(int idx=0;idx<13;idx++){
                String d=glyphs.get(code.charAt(idx));
                if(d==null)continue;

                float cx;
                if(idx==0){
                    cx=left+leadW/2f;
                }else{
                    int st=idx<7?1:7,en=idx<7?7:13;
                    float first=barLeft+(REF_CENTERS[st]-REF_BAR_X0)/570f*scaledBarW;
                    float last=barLeft+(REF_CENTERS[en-1]-REF_BAR_X0)/570f*scaledBarW;
                    float t=(idx-st)/(float)(en-st-1);
                    cx=first+(last-first)*t;
                }

                Path p=PathParser.createPathFromPathData(d);
                RectF b=new RectF();
                p.computeBounds(b,true);

                // Uniform digit scale preserves the original glyph aspect ratio.
                float sx=digitScale;
                float sourceCx=(b.left+b.right)/2f;
                Matrix mm=new Matrix();
                mm.setScale(sx,sx);
                mm.postTranslate(cx-sourceCx*sx,top-b.top*sx);
                p.transform(mm);
                canvas.drawPath(p,paint);
            }

            canvas.restore();

            // Preview frame only. It is NOT part of the printable bitmap.
            paint.setStyle(Paint.Style.STROKE);
            paint.setColor(0xFF999999);
            paint.setStrokeWidth(1);
            canvas.drawRect(.5f,.5f,w-.5f,h-.5f,paint);
            paint.setStyle(Paint.Style.FILL);
        }

        @Override protected void onDraw(Canvas c){
            super.onDraw(c);
            drawBarcode(c,getWidth(),getHeight());
        }
        Bitmap renderBitmap(){
            int w=PRINT_W;
            String code=normalize();

            // Determine the real printed bottom from the current barcode geometry.
            float sy=Math.max(0.15f,(Math.max(140,(int)(w*.34f))*0.58f)/(464.5f-8f));
            float dataH=(REF_DATA_Y1-REF_Y_TOP)*sy*barHeight;
            float guardH=Math.max(dataH,(REF_GUARD_Y1-REF_Y_TOP)*sy*barHeight);
            float contentBottom=TOP_MARGIN_PX+guardH;
            int h=Math.max(TOP_MARGIN_PX+1,(int)Math.ceil(contentBottom));

            Bitmap b=Bitmap.createBitmap(w,h,Bitmap.Config.ARGB_8888);
            drawBarcode(new Canvas(b),w,h);
            return b;
        }

        @Override public boolean onTouchEvent(MotionEvent e){
            int n=e.getPointerCount();
            switch(e.getActionMasked()){
                case MotionEvent.ACTION_DOWN:downX=e.getX();downY=e.getY();startMoveX=moveX;startMoveY=moveY;twoFinger=false;return true;
                case MotionEvent.ACTION_POINTER_DOWN:
                    if(n>=2){twoFinger=true;lastDist=dist(e);lastMidX=midX(e);lastMidY=midY(e);} return true;
                case MotionEvent.ACTION_MOVE:
                    if(n==1&&!twoFinger){
                        moveX=startMoveX+(e.getX()-downX)/getWidth()*2.2f;
                        moveY=startMoveY+(e.getY()-downY)/getHeight()*2.2f;
                    }else if(n>=2){
                        float nd=dist(e),dx=midX(e)-lastMidX,dy=midY(e)-lastMidY;
                        if(Math.abs(nd-lastDist)>Math.abs(dx)+Math.abs(dy)) zoom=Math.max(.2f,Math.min(3f,zoom+(nd-lastDist)/300f));
                        else if(Math.abs(dx)>=Math.abs(dy)){
                            float f=scaleX+dx/300f;
                            f=Math.max(.3f,Math.min(2.5f,f));
                            scaleX=f; scaleY=f;
                        }else{
                            float f=scaleY+dy/300f;
                            f=Math.max(.3f,Math.min(2.5f,f));
                            scaleX=f; scaleY=f;
                        }
                        lastDist=nd;lastMidX=midX(e);lastMidY=midY(e);
                    }
                    invalidate();return true;
                case MotionEvent.ACTION_POINTER_UP:
                    if(n<=2){twoFinger=false;downX=e.getX(0);downY=e.getY(0);startMoveX=moveX;startMoveY=moveY;}return true;
                case MotionEvent.ACTION_UP:case MotionEvent.ACTION_CANCEL:twoFinger=false;return true;
            }
            return true;
        }
        float dist(MotionEvent e){return e.getPointerCount()<2?0:(float)Math.hypot(e.getX(0)-e.getX(1),e.getY(0)-e.getY(1));}
        float midX(MotionEvent e){return(e.getX(0)+e.getX(1))/2f;} float midY(MotionEvent e){return(e.getY(0)+e.getY(1))/2f;}
    }
}
