public class MainActivity extends Activity {
    static final String PRINTER_PACKAGE = "com.farminos.print";
    BarcodeView preview;
    SlotEditText input;
    boolean shift = false;
    final SliderCtl[] sliders = new SliderCtl[8];
    final float[] fineCenter = new float[8];
    boolean suppressSeekCallbacks=false;

    @Override public void onCreate(Bundle b) {
        super.onCreate(b);
        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(8,6,8,6);

        TextView title = new TextView(this);
        title.setText("CB13 • EAN-13");
        title.setTextSize(20);
        root.addView(title, new LinearLayout.LayoutParams(-1,42));

        input = new SlotEditText(this);
        input.setText("5901234123457");
        input.setTextSize(25);
        input.setSingleLine(true);
        input.setPadding(8,0,8,0);
        input.setBackground(new ColorDrawable(0xFFE7E7E7));
        input.setOnSlotChangedListener(() -> { preview.setEan(input.getValue()); });
        root.addView(input,new LinearLayout.LayoutParams(-1,54));

        preview = new BarcodeView(this);
        preview.setEan(input.getValue());
        LinearLayout.LayoutParams vp=new LinearLayout.LayoutParams(-1,0,1f);
        vp.topMargin=6; vp.bottomMargin=6;
        root.addView(preview,vp);

        addSlider(root,0,"Zoom",50,200,100);
        addSlider(root,1,"Scale X",50,150,100);
        addSlider(root,2,"Scale Y",50,150,100);
        addSlider(root,3,"Move X",0,100,50);
        addSlider(root,4,"Move Y",0,100,50);
        addSlider(root,5,"Digit width",50,150,100);
        addSlider(root,6,"Group spacing",50,150,100);
        addSlider(root,7,"Bar height",50,150,100);

        LinearLayout bottom=new LinearLayout(this);
        TextView hint=new TextView(this);
        hint.setText("Tap a slider name for ±5% fine tune");
        hint.setTextSize(11);
        bottom.addView(hint,new LinearLayout.LayoutParams(0,52,1f));

        Button share=new Button(this); share.setText("SHARE / PRINT");
        share.setOnClickListener(v->shareBitmap(!shift));
        bottom.addView(share,new LinearLayout.LayoutParams(0,52,1f));
        root.addView(bottom);

        setContentView(root);
    }

    void addSlider(LinearLayout root,int i,String name,int min,int max,int value){
        LinearLayout row=new LinearLayout(this);
        row.setGravity(android.view.Gravity.CENTER_VERTICAL);
        TextView label=new TextView(this); label.setText(name); label.setTextSize(12);
        label.setGravity(android.view.Gravity.CENTER_VERTICAL);
        row.addView(label,new LinearLayout.LayoutParams(88,42));
        SeekBar bar=new SeekBar(this); bar.setMax(1000);
        suppressSeekCallbacks=true;
        bar.setProgress(Math.round((value-min)*1000f/(max-min)));
        suppressSeekCallbacks=false;
        row.addView(bar,new LinearLayout.LayoutParams(0,42,1f));
        TextView val=new TextView(this); val.setText(String.format(Locale.US,"%.1f%%",(float)value)); val.setTextSize(12);
        row.addView(val,new LinearLayout.LayoutParams(65,42));
        SliderCtl ctl=new SliderCtl(name,min,max,bar,val,i); ctl.current=value; ctl.normal=value; sliders[i]=ctl;
        label.setOnClickListener(v -> {
            if(!ctl.fine){
                ctl.center=ctl.current;
                ctl.fine=true;
                ctl.bar.setProgress(500, false);
                val.setText(formatValue(i,ctl.current));
                label.setText("✓ "+name);
            }else{
                ctl.fine=false;
                ctl.normal=ctl.current;
                ctl.bar.setProgress(ctl.progressFromNormalValue(ctl.current), false);
                val.setText(formatValue(i,ctl.current));
                label.setText(name);
            }
            applySliders();
        });
        bar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener(){
            public void onProgressChanged(SeekBar b,int p,boolean fromUser){
                if(suppressSeekCallbacks)return;
                ctl.current=ctl.valueFromProgress(p);
                if(!shift || !ctl.fine) ctl.normal=ctl.current;
                val.setText(formatValue(i,ctl.current));
                applySliders();
            }
            public void onStartTrackingTouch(SeekBar b){}
            public void onStopTrackingTouch(SeekBar b){}
        });
        label.setOnClickListener(v -> {
            if(shift) toggleFineSlider(ctl,label);
        });
        root.addView(row);
    }

    void setProgressSilently(SeekBar bar,int progress){
        suppressSeekCallbacks=true;
        bar.setProgress(progress);
        suppressSeekCallbacks=false;
    }

    void toggleFineSlider(SliderCtl s, TextView label){
        if(!s.fine){
            // Enter fine mode around the CURRENT absolute value.
            // Moving the SeekBar to its middle must not change that value.
            s.center=s.current;
            s.fine=true;
            fineCenter[s.index]=s.current;
            setProgressSilently(s.bar,500);
            label.setBackgroundColor(0xFFBDBDBD);
        }else{
            // Leave fine mode. Keep the value selected in the fine window
            // and restore the absolute-value position.
            s.fine=false;
            setProgressSilently(s.bar,s.progressFromNormalValue(s.current));
            label.setBackgroundColor(Color.TRANSPARENT);
        }
        s.valueView.setText(formatValue(s.index,s.current));
        applySliders();
    }

    String formatValue(int i,float v){
        if(i==3||i==4)return String.format(Locale.US,"%+.1f%%",(v-50f)*2f);
        return String.format(Locale.US,"%.1f%%",v);
    }

    void setShift(boolean on){
        shift=on;
    }

    void applySliders(){
        if(preview==null)return;
        preview.zoom=sliders[0].current/100f;
        preview.scaleX=sliders[1].current/100f;
        preview.scaleY=sliders[2].current/100f;
        preview.moveX=(sliders[3].current-50f)/50f;
        preview.moveY=(sliders[4].current-50f)/50f;
        preview.digitWidth=sliders[5].current/100f;
        preview.groupSpacing=sliders[6].current/100f;
        preview.barHeight=sliders[7].current/100f;
        preview.invalidate();
    }

    void shareBitmap(boolean direct){
        try{
            File dir=new File(getCacheDir(),"cb13"); dir.mkdirs();
            File file=new File(dir,"cb13.png");
            FileOutputStream out=new FileOutputStream(file);
            preview.renderBitmap().compress(Bitmap.CompressFormat.PNG,100,out);
            out.close();
            Uri uri=FileProvider.getUriForFile(this,getPackageName()+".fileprovider",file);
            Intent send=new Intent(Intent.ACTION_SEND);
            send.setType("image/png"); send.putExtra(Intent.EXTRA_STREAM,uri);
            send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
            if(direct){
                send.setPackage(PRINTER_PACKAGE);
                try{startActivity(send);return;}catch(Exception ignored){send.setPackage(null);}
            }
            startActivity(Intent.createChooser(send,"Share / print"));
        }catch(Exception e){Toast.makeText(this,"Share failed: "+e.getMessage(),Toast.LENGTH_LONG).show();}
    }

    static class SliderCtl{
        String name; int min,max,index; SeekBar bar; TextView valueView;
        float current,normal,center; boolean fine;
        SliderCtl(String n,int mn,int mx,SeekBar b,TextView v,int i){name=n;min=mn;max=mx;bar=b;valueView=v;index=i;}
        float valueFromProgress(int p){
            if(!fine)return min+(max-min)*(p/1000f);
            float span=Math.max(0.01f,Math.abs(center)*0.05f);
            if(index==3||index==4)span=5f;
            return center-span+(2f*span)*(p/1000f);
        }
        int progressFromNormalValue(float v){
            return Math.max(0,Math.min(1000,Math.round((v-min)*1000f/(max-min))));
        }
    }

    static class SlotEditText extends EditText{
        interface Listener{void changed();}
        Listener listener;
        void setOnSlotChangedListener(Listener l){ listener=l; }
        String getValue(){
            String s=getText().toString();
            StringBuilder b=new StringBuilder();
            for(int i=0;i<Math.min(13,s.length());i++)b.append(Character.isDigit(s.charAt(i))?s.charAt(i):' ');
            while(b.length()<13)b.append(' ');
            return b.toString();
        }
        boolean internal=false;
        SlotEditText(Context c){
            super(c);
            setInputType(android.text.InputType.TYPE_CLASS_NUMBER);
            if(android.os.Build.VERSION.SDK_INT>=29){
                setCursorVisible(false);
                setHighlightColor(0x55333333);
            }
            addTextChangedListener(new android.text.TextWatcher(){
                String before;
                int start;
                public void beforeTextChanged(CharSequence s,int st,int count,int after){before=s.toString();start=st;}
                public void onTextChanged(CharSequence s,int st,int beforeCount,int count){}
                public void afterTextChanged(android.text.Editable e){
                    if(internal)return;
                    String now=e.toString();
                    // Keep exactly 13 fixed slots. A typed digit replaces the slot
                    // instead of inserting and shifting the remaining digits.
                    if(now.length()>13){
                        internal=true;
                        String base=before;
                        if(start<0)start=0;
                        char inserted=' ';
                        for(int i=start;i<now.length() && i<start+(now.length()-before.length()+1);i++){
                            char ch=now.charAt(i);
                            if(Character.isDigit(ch)){inserted=ch;break;}
                        }
                        StringBuilder b=new StringBuilder(base);
                        while(b.length()<13)b.append(' ');
                        if(start<13 && Character.isDigit(inserted))b.setCharAt(start,inserted);
                        e.replace(0,e.length(),b);
                        setSelection(Math.min(13,start+1));
                        internal=false;
                    } else if(now.length()<13){
                        internal=true;
                        while(e.length()<13)e.append(' ');
                        internal=false;
                    }
                    if(listener!=null)listener.changed();
                }
            });
        }
        @Override protected void onDraw(Canvas c){
            super.onDraw(c);
            if(!hasSelection() || getSelectionStart()!=getSelectionEnd()) return;
            int slot=Math.max(0,Math.min(12,getSelectionStart()));
            float left=getCompoundPaddingLeft()+slot*(getWidth()-getCompoundPaddingLeft()-getCompoundPaddingRight())/13f;
            float right=getCompoundPaddingLeft()+(slot+1)*(getWidth()-getCompoundPaddingLeft()-getCompoundPaddingRight())/13f;
            Paint p=new Paint();
            p.setStyle(Paint.Style.STROKE);
            p.setStrokeWidth(3f);
            p.setColor(0xFF555555);
            c.drawRect(left+1,getPaddingTop()+2,right-1,getHeight()-getPaddingBottom()-2,p);
        }

        @Override public boolean onKeyDown(int key,android.view.KeyEvent e){
            int p=Math.max(0,Math.min(12,getSelectionStart()));
            if(key==android.view.KeyEvent.KEYCODE_DEL){
                if(p>0){getText().replace(p-1,p," ");setSelection(p-1);if(listener!=null)listener.changed();}
                return true;
            }
            if(key==android.view.KeyEvent.KEYCODE_FORWARD_DEL){
                if(p<13){getText().replace(p,p+1," ");setSelection(p);if(listener!=null)listener.changed();}
                return true;
            }
            return super.onKeyDown(key,e);
        }
        @Override public boolean onTextContextMenuItem(int id){
            boolean r=super.onTextContextMenuItem(id); if(listener!=null)listener.changed(); return r;
        }
    }

