<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02060A"
    tools:context=".MainActivity">

    <com.cb13.CockpitBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <EditText
        android:id="@+id/cockpit_ean"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="180dp"
        android:layout_marginEnd="180dp"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="5901234123457"
        android:textColor="#E9FFFA"
        android:textSize="21sp" />

    <FrameLayout
        android:id="@+id/cockpit_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="120dp"
        android:layout_marginEnd="120dp"
        android:layout_marginTop="235dp"
        android:layout_marginBottom="250dp" />

    <com.cb13.NeonDialView
        android:id="@+id/dial_zoom"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="270dp" />

    <com.cb13.NeonDialView
        android:id="@+id/dial_scale_x"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="270dp" />

    <com.cb13.NeonDialView
        android:id="@+id/dial_scale_y"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="415dp" />

    <com.cb13.NeonDialView
        android:id="@+id/dial_move_x"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="415dp" />

    <com.cb13.NeonDialView
        android:id="@+id/dial_move_y"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="560dp" />

    <com.cb13.NeonDialView
        android:id="@+id/dial_digit"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="560dp" />

    <com.cb13.NeonDialView
        android:id="@+id/dial_group"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="705dp" />

    <com.cb13.NeonDialView
        android:id="@+id/dial_bar"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="705dp" />

    <com.cb13.NeonDialView
        android:id="@+id/dial_feed"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="850dp" />

    <Switch
        android:id="@+id/cockpit_fine"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="18dp"
        android:text="SHIFT FINE TUNE"
        android:textColor="#35F2C2" />

    <LinearLayout
        android:id="@+id/cockpit_commands"
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="18dp">

        <Button android:layout_width="110dp" android:layout_height="58dp" android:text="&lt;" />
        <Button android:layout_width="110dp" android:layout_height="58dp" android:text="&lt;&lt;" />
        <Button android:layout_width="110dp" android:layout_height="58dp" android:text="AUTO" />
        <Button android:layout_width="110dp" android:layout_height="58dp" android:text="SCAN" />
        <Button android:layout_width="110dp" android:layout_height="58dp" android:text="⋮" />
        <Button android:layout_width="110dp" android:layout_height="58dp" android:text="SHARE / PRINT" />
    </LinearLayout>

</FrameLayout>
